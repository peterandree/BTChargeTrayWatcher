<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>BTChargeTrayWatcher.Tests</RootNamespace>

    <!-- Match main project architecture to avoid MSIL/AMD64 mismatch -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Optional: avoids accidental WinForms coupling -->
    <!-- <UseWindowsForms>true</UseWindowsForms> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0-pre.108" />
    <!-- MTP-native code coverage. coverlet.collector/msbuild do not work with the
         Microsoft Testing Platform runner (per the coverlet repo), which is why the
         previous coverlet-based CI coverage step always failed. This extension is
         auto-registered by the xUnit v3 MTP runner; invoke via the coverage flag. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BTChargeTrayWatcher.csproj" />
  </ItemGroup>

</Project>